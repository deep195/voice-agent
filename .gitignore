.venv/
__pycache__/
*.pyc
*.wav
_srv.log
_srv.err

# Eval output: regenerated by every run, and a baseline you want to keep belongs in a file
# you pass to --baseline yourself. The numbers that belong in the README are written up by
# hand in evals/BENCHMARKS.md.
evals/results.jsonl
evals/*.json
evals/_*.jsonl
# --out / --json take a name of the caller's choosing: any *.jsonl in evals/ is output
# except the golden set, which is source. The doc examples write out.json in the root.
evals/*.jsonl
!evals/golden.jsonl
# Root-level runs follow the same _ scratch prefix as _srv.log; a root-level baseline
# (old.jsonl, previous.jsonl in the docs) keeps its name and stays tracked.
/_*.jsonl
/out.json

# Secrets and local settings: never commit these
.env
.env.*
*.local
# Voice and speech models: downloaded on first run, far too large for git
*.onnx
voices-*.bin
*.npz
